# Koneksi PostgreSQL. Untuk pengembangan lokal, jalankan `npm run db:up`
# lalu pakai nilai yang dicetak perintah tersebut.
# Untuk produksi: arahkan ke instance Postgres Anda (Supabase / RDS / VPS).
DATABASE_URL="postgresql://bukuagenda@127.0.0.1:5433/bukuagenda"

# Kunci penanda tangan cookie sesi. Wajib diganti di produksi.
# Buat nilai acak: openssl rand -base64 48
SESSION_SECRET="ganti-dengan-nilai-acak-minimal-32-karakter"
